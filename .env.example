# =============================================================================
# manuelaX — environment template (copy to .env.local for local dev)
# The client fills in secrets after domain + merchant accounts are ready.
# =============================================================================

# --- Required for any environment ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
AUTH_SECRET="generate-a-long-random-string"

# Public site URL — use localhost until the client owns a domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (required for password reset / verification in staging+) ---
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="noreply@yourdomain.com"

# --- Sanity CMS (catalog content + Studio) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# SANITY_API_WRITE_TOKEN=""   # server-only; needed for creator publish pipeline

# =============================================================================
# DEMO / PRE-LAUNCH (no payment merchant account needed)
# Set these for client walkthroughs before CCBill is configured.
# =============================================================================

# Simulates successful checkout for platform + creator payments (local/staging demo)
BILLING_DEV_MODE="true"

# Optional: auto-approve creator onboarding in staging (skip manual admin step)
# CREATOR_AUTO_APPROVE="true"

# Age gate: DOB self-attestation works without Veriff (fine for demos)
# AGE_VERIFICATION_ALLOW_SELF_ATTESTATION="true"

# =============================================================================
# PRODUCTION ONLY — client configures after domain + CCBill merchant approval
# Do NOT share real values with the development vendor.
# =============================================================================

# NEXT_PUBLIC_APP_URL="https://www.client-domain.com"

# CCBill — platform subscriptions
# CCBILL_ACCOUNT=""
# CCBILL_SUBACCOUNT=""
# CCBILL_SALT=""
# CCBILL_FLEXFORM_ID=""
# CCBILL_WEBHOOK_SECRET=""

# CCBill — creator PPV, tips, subscriptions
# CCBILL_CREATOR_ONETIME_FLEXFORM_ID=""
# CCBILL_CREATOR_SUB_FLEXFORM_ID=""

# Webhook URLs (client sets in CCBill dashboard after deploy):
#   POST https://www.client-domain.com/api/webhooks/ccbill

# --- Optional: strict ID age verification (Veriff) ---
# AGE_VERIFICATION_PROVIDER="veriff"
# AGE_VERIFICATION_API_KEY=""
# AGE_VERIFICATION_WEBHOOK_SECRET=""
# POST https://www.client-domain.com/api/webhooks/veriff

# --- Optional ---
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# ADMIN_EMAIL="admin@client-domain.com"
# REDIS_URL=""
# MUX_TOKEN_ID=""
# MUX_SIGNING_KEY=""
# MUX_SIGNING_KEY_ID=""
