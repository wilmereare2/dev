{
  "name": "manuelax",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev --turbopack",
    "dev:fast": "next dev --turbopack",
    "dev:stable": "next dev",
    "dev:fresh": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev --turbopack",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "build:app": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "sanity:typegen": "sanity schema extract && sanity typegen generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^11.6.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "otplib": "^13.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanity": "^4.22.0",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
