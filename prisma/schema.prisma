// PostgreSQL (Neon/Supabase) — production + local dev via DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Role values: ADMIN | EDITOR | MODERATOR | VIEWER | USER | CREATOR
model User {
  id            String         @id @default(cuid())
  username      String?        @unique
  name          String?
  email         String         @unique
  emailVerified DateTime?
  phone         String?        @unique
  phoneVerified DateTime?
  gender        String?
  country       String?
  race          String?
  hobbies       String?
  telegram      String?
  whatsApp      String?
  zangi         String?
  image         String?
  passwordHash  String?
  role          String         @default("USER")
  accountStatus String         @default("active")
  suspendedAt   DateTime?
  bannedAt      DateTime?
  banReason     String?
  lastSeenAt    DateTime?
  accounts      Account[]
  sessions      Session[]
  settings      UserSettings?
  twoFactor     TwoFactorAuth?
  bookmarks     Bookmark[]
  watchLater    WatchLater[]
  watchHistory  WatchHistory[]
  creatorFollows CreatorFollow[]
  contentLikes  ContentLike[]
  collections   Collection[]
  subscriptions Subscription[]
  payments      PaymentRecord[]
  notifications Notification[]
  reports       ContentReport[] @relation("Reporter")
  tickets       SupportTicket[]
  termsAccepted TermsAcceptance[]
  blockedUsers  BlockedUser[]   @relation("Blocker")
  blockedBy     BlockedUser[]   @relation("Blocked")
  mutedUsers    MutedUser[]     @relation("Muter")
  mutedBy       MutedUser[]     @relation("Muted")
  comments      Comment[]
  referralsMade Referral[]      @relation("ReferralsMade")
  referralReceived Referral?    @relation("ReferralReceived")
  creatorProfile   CreatorProfile?
  businessMembers  BusinessMember[]
  ownedBusinessAccounts BusinessAccount[] @relation("BusinessOwner")
  creatorUploads   CreatorUpload[] @relation("UploadCreator")
  promotionalPosts PromotionalPost[]
  creatorSubscriptionsAsCreator CreatorSubscription[] @relation("CreatorSubCreator")
  creatorSubscriptionsAsSubscriber CreatorSubscription[] @relation("CreatorSubSubscriber")
  contentPurchases ContentPurchase[]
  tipsSent         Tip[] @relation("TipFrom")
  tipsReceived     Tip[] @relation("TipTo")
  moderationActions ContentModerationLog[] @relation("ModerationActor")
  chatMessages     ChatMessage[]
  directConversationsLow  DirectConversation[] @relation("DirectConvLow")
  directConversationsHigh DirectConversation[] @relation("DirectConvHigh")
  directMessagesSent      DirectMessage[]
  memberGroupsCreated     MemberGroup[]        @relation("GroupCreator")
  memberGroupMemberships  MemberGroupMember[]
  groupMessagesSent       GroupMessage[]
  advertisementsCreated   Advertisement[] @relation("AdsCreated")
  adCreativesUploaded     AdCreative[]    @relation("AdCreativeUploader")
  adminNotesAuthored      AdminNote[]     @relation("AdminNotesAuthor")
  auditLogs               AuditLog[]      @relation("AuditLogActor")
  assignedReports         ContentReport[] @relation("ReportAssignee")
  resolvedReports         ContentReport[] @relation("ReportResolver")
  reportEvents            ReportEvent[]   @relation("ReportEventActor")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
  @@index([accountStatus, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  userId              String    @id
  bio                 String?
  locale              String    @default("en")
  avatarScale         Int       @default(100)
  avatarFocusX        Int       @default(0)
  avatarFocusY        Int       @default(0)
  showActivity        Boolean   @default(true)
  anonymousMode       Boolean   @default(false)
  hideSubscriptions   Boolean   @default(false)
  emailNotifications  Boolean   @default(true)
  pushNotifications   Boolean   @default(true)
  marketingEmails     Boolean   @default(false)
  uploadAlerts        Boolean   @default(true)
  liveAlerts          Boolean   @default(true)
  promoAlerts         Boolean   @default(false)
  dateOfBirth         DateTime?
  ageVerifiedAt       DateTime?
  ageVerificationMethod String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorAuth {
  userId      String  @id
  secret      String
  enabled     Boolean @default(false)
  backupCodes String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  termsVersion String @default("2026-01")
  privacyVersion String @default("2026-01")
  acceptedAt DateTime @default(now())
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// contentId is a Sanity document _id (CMS is source of truth for media).
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

model WatchLater {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  contentId  String
  progressMs Int      @default(0)
  watchedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([contentId])
}

model CreatorFollow {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

model ContentLike {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

model Collection {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  contentId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, contentId])
  @@index([collectionId])
}

model SubscriptionPlan {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  interval    String
  priceCents  Int
  currency    String         @default("usd")
  trialDays   Int            @default(0)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  status               String           @default("inactive")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  canceledAt           DateTime?
  provider             String           @default("ccbill")
  providerSubscriptionId String?
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

model PaymentRecord {
  id           String   @id @default(cuid())
  userId       String
  amountCents  Int
  currency     String   @default("usd")
  status       String
  provider     String   @default("ccbill")
  providerRef  String?
  description  String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ContentReport {
  id           String   @id @default(cuid())
  reporterId   String
  contentId    String?
  targetUserId String?
  reason       String
  details      String?
  category     String   @default("other")
  priority     String   @default("normal")
  status       String   @default("open")
  assigneeId   String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee     User?    @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy   User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  events       ReportEvent[]

  @@index([status, createdAt])
  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model MutedUser {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())
  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId, approved])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  entity        String?
  entityId      String?
  targetLabel   String?
  previousValue String?
  newValue      String?
  reason        String?
  ipAddress     String?
  userAgent     String?
  meta          String?
  createdAt     DateTime @default(now())
  actor         User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model AdminNote {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  author     User     @relation("AdminNotesAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([authorId])
}

model ReportEvent {
  id             String        @id @default(cuid())
  reportId       String
  actorId        String?
  action         String
  note           String?
  previousStatus String?
  newStatus      String?
  createdAt      DateTime      @default(now())
  report         ContentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor          User?         @relation("ReportEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
}

model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredUserId String?  @unique
  code           String   @unique
  rewardCents    Int      @default(0)
  createdAt      DateTime @default(now())
  referrer       User     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred       User?    @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referrerId])
}

/// Links a platform User (CREATOR role) to Sanity creator document + verification.
model CreatorProfile {
  userId               String    @id
  sanityCreatorId      String?   @unique
  sanityCreatorSlug    String?   @unique
  displayName          String?
  bio                  String?
  verificationStatus   String    @default("pending")
  verifiedAt           DateTime?
  subscriptionPriceCents Int?
  suspendedAt          DateTime?
  suspensionReason     String?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([verificationStatus])
}

/// Studio / agency managing multiple creators.
model BusinessAccount {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  bannerUrl       String?
  verifiedAt      DateTime?
  affiliateUrl    String?
  owner           User?            @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerUserId     String?
  members         BusinessMember[]
  promotionalPosts PromotionalPost[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model BusinessMember {
  id         String          @id @default(cuid())
  businessId String
  userId     String
  role       String          @default("manager")
  business   BusinessAccount @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

/// Creator upload workflow — syncs to Sanity on approval.
model CreatorUpload {
  id                String   @id @default(cuid())
  creatorUserId     String
  sanityContentId   String?  @unique
  title             String
  description       String?
  mediaType         String   @default("video")
  status            String   @default("draft")
  visibility        String   @default("public")
  thumbnailUrl      String?
  mediaUrl          String?
  galleryImages     String?
  tags              String?
  categories        String?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  isPremium         Boolean  @default(false)
  ppvPriceCents     Int?
  fileSizeBytes     Int?
  durationSeconds   Int?
  resolution        String?
  viewCount         Int      @default(0)
  likeCount         Int      @default(0)
  purchaseCount     Int      @default(0)
  favoriteCount     Int      @default(0)
  moderationNotes   String?
  aiModerationScore Float?
  aiModerationFlags String?
  reviewedById      String?
  reviewedAt        DateTime?
  submittedAt       DateTime?
  creator           User     @relation("UploadCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  moderationLogs    ContentModerationLog[]
  purchases         ContentPurchase[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([creatorUserId, status])
  @@index([status, submittedAt])
}

model PromotionalPost {
  id                String           @id @default(cuid())
  creatorUserId     String?
  businessId        String?
  title             String
  body              String?
  bannerUrl         String?
  teaserVideoUrl    String?
  couponCode        String?
  discountPercent   Int?
  externalUrl       String?
  featuredContentId String?
  expiresAt         DateTime?
  status            String           @default("draft")
  creator           User?            @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  business          BusinessAccount? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([creatorUserId, status])
  @@index([businessId])
}

model CreatorSubscription {
  id                 String    @id @default(cuid())
  subscriberId       String
  creatorUserId      String
  status             String    @default("active")
  priceCents         Int
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  subscriber         User      @relation("CreatorSubSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator            User      @relation("CreatorSubCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([subscriberId, creatorUserId])
  @@index([creatorUserId, status])
}

model ContentPurchase {
  id          String         @id @default(cuid())
  userId      String
  uploadId    String?
  contentId   String?
  amountCents Int
  type        String         @default("ppv")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload      CreatorUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([uploadId])
  @@index([contentId])
}

model Tip {
  id              String   @id @default(cuid())
  fromUserId      String
  toCreatorUserId String
  amountCents     Int
  message         String?
  fromUser        User     @relation("TipFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toCreator       User     @relation("TipTo", fields: [toCreatorUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([toCreatorUserId, createdAt])
}

model ContentModerationLog {
  id        String         @id @default(cuid())
  uploadId  String
  actorId   String?
  action    String
  reason    String?
  upload    CreatorUpload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  actor     User?          @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([uploadId, createdAt])
}

model ChatChannel {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  adminOnly   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
}

model AdminManagementCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  href        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  body      String
  createdAt DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([userId, createdAt])
}

model DirectConversation {
  id         String          @id @default(cuid())
  userLowId  String
  userHighId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  userLow    User            @relation("DirectConvLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh   User            @relation("DirectConvHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages   DirectMessage[]

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@index([updatedAt])
}

model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([senderId, createdAt])
}

model MemberGroup {
  id          String              @id @default(cuid())
  name        String
  description String?
  visibility  String              @default("private")
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     MemberGroupMember[]
  messages    GroupMessage[]

  @@index([createdById])
  @@index([updatedAt])
  @@index([visibility])
  @@index([archivedAt])
}

model MemberGroupMember {
  id       String      @id @default(cuid())
  groupId  String
  userId   String
  role     String      @default("member")
  joinedAt DateTime    @default(now())
  group    MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String      @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime    @default(now())
  group     MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([senderId, createdAt])
}

model Advertisement {
  id             String   @id @default(cuid())
  title          String
  advertiserName String
  destinationUrl String
  placement      String
  /// direct = self-hosted banner we serve and count.
  /// network = third-party tag (ExoClick, TrafficJunky, ...) rendered in a
  /// sandboxed iframe so its script never touches the main document.
  creativeType   String   @default("direct")
  networkName    String?
  embedCode      String?
  iframeUrl      String?
  status         String   @default("draft")
  priority       Int      @default(0)
  startAt        DateTime?
  endAt          DateTime?
  imageUrl       String?
  imageUrlTablet String?
  imageUrlMobile String?
  altText        String?
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  lastServedAt   DateTime?
  createdById    String?
  archivedAt     DateTime?
  createdBy      User?    @relation("AdsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  impressionKeys AdImpressionKey[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([placement, status, priority])
  @@index([status, startAt, endAt])
  @@index([createdAt])
}

/// Binary ad banner storage. Keeps base64 payloads out of JSON request bodies
/// and lets browsers cache creatives instead of re-downloading data URLs.
model AdCreative {
  id          String   @id @default(cuid())
  mimeType    String
  byteSize    Int
  checksum    String   @unique
  data        Bytes
  createdById String?
  createdBy   User?    @relation("AdCreativeUploader", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AdImpressionKey {
  id        String        @id @default(cuid())
  adId      String
  dedupeKey String
  createdAt DateTime      @default(now())
  ad        Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, dedupeKey])
  @@index([createdAt])
}
