# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Database — PostgreSQL (Neon/Supabase). Required for auth, library, billing.
# Local: paste your Neon connection string here.
# Vercel: set DATABASE_URL in project Environment Variables.
# Neon tips:
# - DATABASE_URL: pooled host (*-pooler.*) for the running app
# - DIRECT_URL: direct host (no -pooler) for Prisma migrations during build
# - append &connect_timeout=15 if connections stall
# If the project was paused, open the Neon dashboard and wake it before starting the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Sanity CMS (create project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Email (required for password reset + verification in production)
# Without EMAIL_SERVER, local dev does NOT send mail to your inbox.
# Outlook / Microsoft 365 example (use an app password if 2FA is enabled):
# EMAIL_SERVER=smtp://your-address@outlook.com:YOUR_APP_PASSWORD@smtp.office365.com:587
EMAIL_SERVER=
EMAIL_FROM="manuelaX <noreply@yourdomain.com>"

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# CCBill (Phase 4 billing) — required for production card payments
CCBILL_ACCOUNT=
CCBILL_SUBACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_WEBHOOK_SECRET=

# Local testing without CCBill (activates subscriptions instantly in dev)
BILLING_DEV_MODE=true

# Streaming (Phase 5 — Mux or Cloudflare Stream)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_SIGNING_KEY_ID=

# Age verification vendor (Phase 3 — optional)
AGE_VERIFICATION_PROVIDER=
AGE_VERIFICATION_API_KEY=

# Redis (Phase 7 — optional caching)
REDIS_URL=

# Search (Phase 7 — optional Elasticsearch)
ELASTICSEARCH_URL=
